---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import type { MarkdownHeading } from 'astro';
import BaseHead from '../components/BaseHead.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import MetaItem from '../components/MetaItem.astro';
import PostMeta from '../components/PostMeta.astro';
import TableOfContents from '../components/TableOfContents.astro';
import TagList from '../components/TagList.astro';
import { SITE_AUTHOR } from '../consts';
import '../styles/pages/blog-post.css';

type Props = CollectionEntry<'blog'>['data'] & {
	readingTime: number;
	headings: MarkdownHeading[];
};

const { title, description, pubDate, updatedDate, heroImage, heroImageAlt, tags, draft, readingTime, headings } =
	Astro.props;
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
	</head>

	<body>
		<Header />
		<main id="main" class="post-page">
			<article>
				<div class="hero-image">
					{heroImage && <Image width={1020} height={510} src={heroImage} alt={heroImageAlt || ''} />}
				</div>
				<div class="prose">
					<Breadcrumb items={[
						{ label: 'Home', href: '/' },
						{ label: 'Blog', href: '/blog' },
						{ label: title, href: Astro.url.pathname }
					]} />
					<div class="post-header">
						<PostMeta size="lg" centered>
							<MetaItem icon="mdi:calendar">
								<FormattedDate date={pubDate} />
							</MetaItem>
							{
								updatedDate && (
									<MetaItem icon="mdi:calendar-outline" class="last-updated-on">
										Updated <FormattedDate date={updatedDate} />
									</MetaItem>
								)
							}
							<MetaItem icon="mdi:account">
								{SITE_AUTHOR}
							</MetaItem>
							<MetaItem icon="mdi:clock-outline">
								{readingTime} min read
							</MetaItem>
						</PostMeta>
						<h1>{title}</h1>
						{import.meta.env.DEV && draft && <span class="post-draft-badge">Draft</span>}
					</div>
					<TableOfContents headings={headings} />
					<slot />
					<hr aria-hidden="true" />
					<TagList tags={tags} showLabel={true} />
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
