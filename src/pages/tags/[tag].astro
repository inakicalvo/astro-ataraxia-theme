---
import BaseHead from '../../components/BaseHead.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import PostCard from '../../components/PostCard.astro';
import { Icon } from 'astro-icon/components';
import { SITE_TITLE } from '../../consts';
import { slugify } from '../../utils/slugify';
import { getPublishedPosts } from '../../utils/posts';
import '../../styles/pages/tag.css';

export async function getStaticPaths() {
	const allPosts = await getPublishedPosts();
	
	// Get all unique tags
	const uniqueTags = [...new Set(allPosts.flatMap((post) => post.data.tags))];
	
	return uniqueTags.map((tag) => {
		const filteredPosts = allPosts
			.filter((post) => post.data.tags.includes(tag))
			.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
		
		return {
			params: { tag: slugify(tag) },
			props: { posts: filteredPosts, tagName: tag },
		};
	});
}

const { tag } = Astro.params;
const { posts, tagName } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Tag: ${tagName} - ${SITE_TITLE}`} description={`Posts tagged with "${tagName}"`} />
	</head>
	<body>
		<Header />
		<main id="main">
			<section>
				<Breadcrumb items={[
					{ label: 'Home', href: '/' },
					{ label: 'Blog', href: '/blog' },
					{ label: 'Tags', href: '/tags' },
					{ label: tagName, href: `/tags/${tag}` }
				]} />
				<a href="/blog" class="back-link">
					<Icon name="mdi:arrow-left" width={20} height={20} aria-hidden="true" />
					Back to Blog
				</a>
				<div class="tag-header">
					<h1>Posts tagged with</h1>
					<div class="tag-badge">{tagName}</div>
					<p class="subtitle">{posts.length} {posts.length === 1 ? 'post' : 'posts'} found</p>
				</div>
				<ul class="post-list">
					{
						posts.map((post, idx) => (
							<PostCard post={post} loading={idx === 0 ? 'eager' : 'lazy'} tagLimit={3} />
						))
					}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>
