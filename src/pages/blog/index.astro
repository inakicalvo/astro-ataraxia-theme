---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import PostCard from '../../components/PostCard.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';
import { getPublishedPosts } from '../../utils/posts';
import '../../styles/pages/blog-index.css';

const posts = (await getPublishedPosts()).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title=`Blog - ${SITE_TITLE}` description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main id="main">
			<section>
				<div class="blog-header">
					<h1>Blog</h1>
					<p class="subtitle">Learnings, thoughts, and more.</p>
					<a href="/tags" class="tags-link">Browse all tags →</a>
				</div>
				<ul class="post-list">
					{
						posts.map((post, idx) => (
							<PostCard post={post} loading={idx < 2 ? 'eager' : 'lazy'} tagLimit={5} />
						))
					}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>
