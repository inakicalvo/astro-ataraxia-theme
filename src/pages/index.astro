---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import PostCard from '../components/PostCard.astro';
import { RECENT_POSTS_COUNT, SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { getSortedPosts } from '../utils/posts';
import '../styles/pages/home.css';

const recentPosts = await getSortedPosts(RECENT_POSTS_COUNT);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main id="main">
			<section class="home-intro">
				<h1>Welcome to Ataraxia</h1>
				<p>Ataraxia is an accessible, lightweight <a href="https://astro.build/" target="_blank" rel="noopener noreferrer">Astro</a> theme built for writers who want their words to load fast and read clearly. It ships with dark mode, tags, SEO, and RSS out of the box, so you can focus on writing rather than wiring up the basics.</p>
			</section>

			<section class="home-recent">
				<h2>Recent posts</h2>
				<ul class="post-list">
					{
						recentPosts.map((post, idx) => (
							<PostCard post={post} loading={idx === 0 ? 'eager' : 'lazy'} tagLimit={5} />
						))
					}
				</ul>
				<a href="/blog/" class="all-posts-link">All posts →</a>
			</section>
		</main>
		<Footer />
	</body>
</html>
